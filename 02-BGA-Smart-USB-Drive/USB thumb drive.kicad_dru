(version 1)

(rule "U13 via-in-pad size"
    (constraint via_diameter (min 0.3mm))
    (constraint hole_size (min 0.15mm))
    (condition "A.insideCourtyard('U13')")
)

(rule "U13 via-in-pad clearance"
    (constraint clearance (min 0mm))
    (condition "A.Type == 'Via' && A.insideCourtyard('U13') && B.Type == 'Pad' && B.memberOfFootprint('U13')")
)
